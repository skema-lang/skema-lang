spec 1;

import "./common.skema" as base;

Document shop {
  Meta {
    version = "";
    author  = "";
    note    = "";
    styleClasses = [highlight];
  }

  Style @document {
    backgroundColor = "blue";
  }
}

Project {
  mode    = draft;   # strict
  dialect = generic; # postgres, mysql, oracledb

  Meta {
    version = "";
    author  = "";
    note    = "";
    styleClasses = [highlight];
  }

  Database {
    database = "shopsystem";
    schema   = "public";
  }

  Lint {
    fieldNaming = snake_case;
    tableNaming = PascalCase;
    danglingRef = error;
  }

  Style @project {
    fontSize = "2em";
  }

  Style @table {
    headerBackgroundColor = "#cc0000";
    headerTextColor       = "white";
  }

  # Klasse, kein Selektor: wird ueber Meta.styleClasses zugewiesen
  Style highlight {
    borderColor = "#cc0000";
    borderWidth = "3px";
  }
}

Partial common_base {
  id         int       [pk];
  public_id  uuid      [unique];
  created_at timestamp [required, default=`now()`];
}

Enum OrderStatus {
  Field {
    type    = string;
    default = paid;
    note    = "Zustaende einer Bestellung";
  }

  draft     { label = "Draft"; }
  paid      { label = "Paid"; }
  shipped   { label = "Shipped"; value = "S"; }
  cancelled;
}

Table Customer {
  use common_base;

  email   Email             [required];
  country base.CountryCode;

  Index {
    ix_customer_email (email) [unique];
  }
}

Table Order {
  use common_base;

  customer     >Customer.id [required, onDelete=cascade];
  order_status OrderStatus;

  sum float [required] {
    note          = "The full Sum";
    exampleValue  = "19.99";
    "x-customkey" = "Foobar";
  }

  gross_sum decimal(10, 2);

  Database {
    table = "order";
  }

  Meta {
    author = "";
    note   = "";
    styleClasses = [highlight];
  }
}

Group Shop {
  Table Customer;
  Table Order;
  Enum  OrderStatus;
}

Datatype Email {
  Field {
    type  = string;
    regex = "^[^@]+@[^@]+$";
    note  = "E-Mail-Adresse, nicht auf Zustellbarkeit geprueft";
  }
}

Datatype decimal(precision int, scale int) {
  precision { note = "Gesamtzahl der Stellen"; }
  scale     { note = "Anzahl der festen Nachkommastellen"; default = 2; }

  Field {
    type = float;
    note = "Dezimalzahl mit fester Genauigkeit";
  }

  Dialect @postgres { sql = "numeric({precision}, {scale})"; }
  Dialect @mysql    { sql = "DECIMAL({precision}, {scale})"; }
}
