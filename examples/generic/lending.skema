spec 1;

/*
 * Lending: who has what, and for how long.
 * Namespace of this file: lending
 */

Document lending {
  Meta {
    note = "Members and loan transactions";
  }

  Database {
    schema = "lending";
  }
}

import "./types.skema";
import "./catalog.skema" as cat;   # Alias: shorter than "catalog"

Table Member {
  use types.Base;

  email      types.Email  [required, unique];
  name       varchar(120) [required];
  joined_on  date         [required];

  loans <Loan.member;

  Index {
    ix_member_email (email) [unique];
  }

  Meta {
    note         = "Person entitled to borrow";
    styleClasses = [core];
  }
}

/*
 * Many-to-many between Member and Copy.
 *
 * There is no n:m arrow in the language - the join table is written
 * out explicitly. The benefit shows immediately: due_on and returned_at
 * have a place from the start.
 */
Table Loan {
  use types.Base;

  member      >Member.id     [required, onDelete=restrict];
  copy        >cat.Copy.id   [required, onDelete=restrict];
  lent_on     date           [required, default=`now()`];
  due_on      date           [required];
  returned_at timestamp;

  Index {
    ix_loan_member (member);
    ix_loan_due    (due_on);
  }

  Meta {
    note = "A loan transaction. returned_at empty = still ongoing.";
  }
}

Table LoanArchive {
  use types.Identity;

  member_public_id uuid [required];
  copy_barcode     varchar(32) [required];
  lent_on          date [required];
  returned_at      timestamp [required];

  Meta {
    note         = "Decoupled history, survives deletion of members";
    styleClasses = [historical];
  }
}

Group Lending {
  Table Member;
  Table Loan;
  Table LoanArchive;
}
