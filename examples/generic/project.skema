spec 1;

/*
 * Root file of the example project.
 *
 * It carries the single Project block and imports everything that
 * belongs to the project. Tools are handed exactly this file:
 *
 *     erplang check examples/generic/project.skema
 */

Document library {
  Meta {
    version = "1.0.0";
    author  = "example";
    note    = "Library management - catalog and lending";
  }
}

import "./types.skema";
import "./catalog.skema";
import "./lending.skema";

Project {
  mode    = draft;     // draft | strict
  dialect = generic;   // generic | postgres | mysql | oracledb

  Database {
    database = "library";
    schema   = "public";
  }

  Lint {
    fieldNaming = snake_case;
    tableNaming = PascalCase;
    enumNaming  = PascalCase;
    danglingRef = error;
  }

  Meta {
    note      = "Example model demonstrating the language";
    "x-jira"  = "DOC-1";
  }

  Style @project {
    fontSize = "1.1em";
  }

  Style @table {
    headerBackgroundColor = "#1f4e79";
    headerTextColor       = "white";
  }

  Style @relation {
    lineColor = "#888888";
  }

  # Classes carry no @ - they are assigned via Meta.styleClasses
  Style core {
    borderColor = "#1f4e79";
    borderWidth = "3px";
  }

  Style historical {
    backgroundColor = "#f0f0f0";
  }
}
