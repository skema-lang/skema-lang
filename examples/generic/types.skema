spec 1;

/*
 * Building blocks reused throughout the project.
 * Namespace of this file: types
 */

Document types {
  Meta {
    note = "Project-wide data types and field groups";
  }
}

# --- Data types -------------------------------------------------------------

# Without parameters: a domain name for a constraint.
Datatype Isbn {
  Field {
    type  = string;
    regex = "^97[89][0-9]{10}$";
    note  = "ISBN-13 without separators";
  }
}

Datatype Email {
  Field {
    type  = string;
    regex = "^[^@]+@[^@]+$";
    note  = "Not checked for deliverability";
  }
}

# With parameters: arguments are declared and described like fields.
Datatype decimal(precision int, scale int) {
  precision { note = "Total number of digits"; }
  scale     { note = "Fixed decimal places"; default = 2; }

  Field {
    type    = float;
    default = 0;
    note    = "Decimal number with fixed precision";
  }

  Dialect @postgres { sql = "numeric({precision}, {scale})"; }
  Dialect @mysql    { sql = "DECIMAL({precision}, {scale})"; }
}

# Built on another type - decimal(10) uses scale = 2.
Datatype Money {
  Field {
    type = decimal(10);
    note = "Amount in home currency";
  }
}

# --- Field groups ------------------------------------------------------------

Partial Identity {
  id        int  [pk];
  public_id uuid [unique];

  Meta {
    note = "Technical and public key";
  }
}

Partial Timestamps {
  created_at timestamp [required, default=`now()`];
  updated_at timestamp;
}

# A partial may include others.
Partial Base {
  use Identity;
  use Timestamps;
}
