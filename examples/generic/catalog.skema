spec 1;

/*
 * The catalog: what the library owns.
 * Namespace of this file: catalog
 */

Document catalog {
  Meta {
    note = "Works, editions, and physical copies";
  }

  # All tables in this file live in the "catalog" schema,
  # instead of the project-wide "public".
  Database {
    schema = "catalog";
  }
}

import "./types.skema";

Enum CopyState {
  Field {
    type    = string;
    default = available;
    note    = "State of a physical copy";
  }

  available   { label = "Available"; }
  lent        { label = "Lent"; }
  damaged     { label = "Damaged"; }
  lost        { label = "Lost"; value = "X"; }
  withdrawn;
}

Table Author {
  use types.Base;

  name       varchar(120) [required];
  birth_year int;

  # Back-reference: creates NO column, the key lives in Book.
  books <Book.author;

  Index {
    ix_author_name (name);
  }

  Meta {
    note         = "Creator of a work";
    styleClasses = [core];
  }
}

Table Book {
  use types.Base;

  isbn      types.Isbn   [required, unique];
  title     varchar(200) [required];
  author    >Author.id   [required, onDelete=restrict];
  price     types.Money;
  blurb     text;

  copies <Copy.book;

  Index {
    ix_book_title (title);
    ix_book_author_title (author, title);
  }

  Meta {
    author       = "example";
    note         = "Bibliographic edition, not the individual copy";
    styleClasses = [core];
    "x-domain"   = "catalog";
  }
}

Table Copy {
  use types.Base;

  book     >Book.id [required, onDelete=cascade];
  barcode  varchar(32) [required, unique];
  state    CopyState;
  shelf    varchar(16);

  # Physical table name differs from the domain name.
  Database {
    table = "book_copy";
  }

  Meta {
    note = "A single, loanable item";
  }
}

Group Catalog {
  Table Author;
  Table Book;
  Table Copy;
  Enum  CopyState;
}
