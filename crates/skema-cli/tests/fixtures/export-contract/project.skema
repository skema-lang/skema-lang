spec 1;

Document shop {
  Meta {
    author                  = "anna";
    "x-nocobase-datasource" = "main";
  }
}

import "./shared.skema" as sh;

Project { mode = draft; dialect = generic; }

Table Customer {
  use sh.Audited;

  id      int         [pk];
  name    varchar(80) [required, "x-ui-widget" = "input"] {
    note         = "Display name";
    "x-ui-order" = 1;
  }
  status  sh.Status   [required];
  balance sh.Money;

  Meta {
    note               = "Customer master data";
    "x-nocobase-title" = "Customers";
  }
}

Table Tag {
  id       int [pk];
  label    text;
  sku      Sku;
  customer >Customer.id;
}

Datatype Sku(length int) {
  length { note = "Characters after the prefix"; default = 8; }

  Field {
    type  = varchar(20);
    regex = "^SKU-[A-Z0-9]{length}$";
  }
}

Group Core {
  Meta {
    author    = "anna";
    "x-color" = "blue";
  }

  Table Customer;
  Table Tag;
}
